diff --git a/src/simd/CMakeLists.txt b/src/simd/CMakeLists.txt
index 7e059b0..c9e3de9 100644
--- a/src/simd/CMakeLists.txt
+++ b/src/simd/CMakeLists.txt
@@ -7,7 +7,12 @@ target_compile_features(ms_simd PUBLIC cxx_std_23)
 # enables Kernel::Avx512 reporting and the dedicated avx512_dgemm TU.
 # Compiling this TU as AVX-512 would SIGILL on machines without the ISA
 # (CI already passes -DMS_ENABLE_AVX512=OFF).
-if(MSVC)
+if(EMSCRIPTEN)
+    # WebAssembly has one SIMD ISA and it is not x86's. Passing -mavx2 here is
+    # a hard error from emcc, which also refuses any -m<x86 isa> flag unless
+    # -msimd128 comes with it. xsimd maps onto wasm128 from this flag alone.
+    target_compile_options(ms_simd PRIVATE -msimd128)
+elseif(MSVC)
     target_compile_options(ms_simd PRIVATE /arch:AVX2)
 elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
     target_compile_options(ms_simd PRIVATE -mavx2 -mfma)
diff --git a/src/simd/isa.cpp b/src/simd/isa.cpp
index a5d7c48..7230660 100644
--- a/src/simd/isa.cpp
+++ b/src/simd/isa.cpp
@@ -1,20 +1,22 @@
 #include "ms/simd/isa.hpp"
 #include <string>
 
+#if MS_ISA_X86
 #if defined(_MSC_VER)
 #include <intrin.h>
-#elif defined(__GNUC__) || defined(__clang__)
+#else
 #include <cpuid.h>
 #endif
+#endif
 
 namespace ms::simd {
 
 namespace {
 
 void cpuid(int info[4], int leaf, int subleaf = 0) {
-#if defined(_MSC_VER)
+#if MS_ISA_X86 && defined(_MSC_VER)
     __cpuidex(info, leaf, subleaf);
-#elif defined(__GNUC__) || defined(__clang__)
+#elif MS_ISA_X86
     __cpuid_count(leaf, subleaf, info[0], info[1], info[2], info[3]);
 #else
     (void)leaf;
@@ -27,6 +29,11 @@ void cpuid(int info[4], int leaf, int subleaf = 0) {
 
 IsaFeatures detect_isa() {
     IsaFeatures f;
+#if !MS_ISA_X86
+    // Nothing to interrogate: the vector width is fixed at compile time.
+    f.wasm_simd128 = MS_ISA_WASM_SIMD != 0;
+    return f;
+#else
     int info[4] = {0, 0, 0, 0};
     cpuid(info, 0);
     if (info[0] == 0) {
@@ -43,6 +50,7 @@ IsaFeatures detect_isa() {
     f.avx2 = (info[1] & (1 << 5)) != 0;
     f.avx512f = (info[1] & (1 << 16)) != 0;
     return f;
+#endif
 }
 
 std::string isa_summary(const IsaFeatures& features) {
@@ -65,6 +73,9 @@ std::string isa_summary(const IsaFeatures& features) {
     if (features.sse2) {
         s += "SSE2 ";
     }
+    if (features.wasm_simd128) {
+        s += "WASM SIMD128 ";
+    }
     if (s.empty()) {
         return "scalar";
     }
